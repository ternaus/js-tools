{
  "name": "@ternaus/openapi-fetch",
  "description": "Type-safe Fetch API client for generated OpenAPI declarations.",
  "version": "1.0.0",
  "author": {
    "name": "Drew Powers",
    "email": "drew@pow.rs"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "homepage": "https://ternaus.github.io/js-tools/openapi-fetch/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ternaus/js-tools.git",
    "directory": "packages/openapi-fetch"
  },
  "bugs": {
    "url": "https://github.com/ternaus/js-tools/issues"
  },
  "keywords": [
    "openapi",
    "swagger",
    "rest",
    "api",
    "oapi_3",
    "oapi_3_1",
    "typescript",
    "fetch",
    "react"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "format": "biome format . --write",
    "lint": "pnpm run lint:js && pnpm run typecheck",
    "lint:js": "biome lint . --error-on-warnings",
    "generate-types": "openapi-typescript -c test/redocly.yaml",
    "prepack": "pnpm run build",
    "pretest": "pnpm run generate-types",
    "test": "pnpm run test:js && pnpm run test:exports",
    "test:js": "vitest run --config ../../vitest.config.ts --project openapi-fetch",
    "test:exports": "publint --strict",
    "test-e2e": "playwright test",
    "e2e-vite-build": "vite build test/e2e/app",
    "e2e-vite-start": "vite preview test/e2e/app",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ternaus/openapi-typescript-helpers": "workspace:^"
  },
  "devDependencies": {
    "@ternaus/openapi-typescript": "workspace:^"
  },
  "engines": {
    "node": "^24.15.0 || ^26.0.0"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "maintainers": [
    {
      "name": "Vladimir Iglovikov",
      "url": "https://github.com/ternaus"
    }
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
