{
  "name": "@ternaus/openapi-react-query",
  "description": "Fast, type-safe @tanstack/react-query client to work with your OpenAPI schema.",
  "version": "0.5.4",
  "author": {
    "name": "Martin Paucot",
    "email": "contact@martin-paucot.fr"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "homepage": "https://ternaus.github.io/js-tools/openapi-react-query/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ternaus/js-tools.git",
    "directory": "packages/openapi-react-query"
  },
  "bugs": {
    "url": "https://github.com/ternaus/js-tools/issues"
  },
  "keywords": [
    "openapi",
    "swagger",
    "rest",
    "api",
    "oapi_3",
    "oapi_3_1",
    "typescript",
    "fetch",
    "react",
    "react-query",
    "tanstack"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "biome format . --write",
    "lint": "pnpm run lint:js && pnpm run typecheck",
    "lint:js": "biome lint . --error-on-warnings",
    "generate-types": "openapi-typescript test/fixtures/api.yaml -o test/fixtures/api.d.ts",
    "prepack": "pnpm run build",
    "test": "pnpm run generate-types && pnpm run test:js && pnpm run test:exports",
    "test:js": "vitest run --config ../../vitest.config.ts --project openapi-react-query",
    "test:exports": "publint --strict",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ternaus/openapi-typescript-helpers": "workspace:^"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.104.0",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "msw": "3.0.1",
    "@ternaus/openapi-fetch": "workspace:^",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "6.1.6",
    "@ternaus/openapi-typescript": "workspace:^"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.80.0",
    "@ternaus/openapi-fetch": "workspace:^",
    "react": "^19.0.0"
  },
  "engines": {
    "node": "^24.15.0 || ^26.0.0"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "maintainers": [
    {
      "name": "Vladimir Iglovikov",
      "url": "https://github.com/ternaus"
    }
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
