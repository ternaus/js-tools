{
  "name": "@ternaus/js-tools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "turbo run build --filter=@ternaus/*",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint && pnpm run check:contracts && pnpm run typecheck",
    "dev": "pnpm run -r --parallel --filter \"{packages/*}\" --aggregate-output dev",
    "format": "biome check --write --linter-enabled=false .",
    "test": "turbo run test --filter=@ternaus/*",
    "test-e2e": "turbo run test-e2e",
    "size": "turbo run size-limit",
    "version": "changeset version && pnpm install --lockfile-only",
    "quality:precommit": "pnpm run format:check && pnpm run lint",
    "quality:complete": "pnpm run build && pnpm run lint && pnpm test",
    "docs:build": "pnpm --filter @example/js-tools-docs build",
    "lint:biome": "biome lint packages scripts eslint.config.js vitest.config.ts --error-on-warnings",
    "lint:eslint": "eslint packages/eslint-plugin-react",
    "format:check": "biome check --linter-enabled=false .",
    "typecheck": "tsc --project tsconfig.tools.json && turbo run typecheck --filter=@ternaus/*",
    "check:contracts": "pnpm --filter @ternaus/eslint-plugin-react run check:citation && pnpm --filter @ternaus/eslint-plugin-react run check:rule-documentation && pnpm --filter @ternaus/eslint-plugin-react run check:biome-completeness && pnpm --filter @ternaus/eslint-plugin-react run check:eslint-residual"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.63.0",
    "@size-limit/preset-small-lib": "14.1.0",
    "@types/node": "26.6.4",
    "prettier": "3.9.9",
    "size-limit": "14.1.0",
    "turbo": "2.11.6",
    "typescript": "catalog:",
    "vitest": "5.0.3",
    "publint": "0.3.25",
    "jsdom": "30.1.1",
    "eslint": "10.8.0",
    "eslint-plugin-eslint-plugin": "7.6.0",
    "eslint-plugin-n": "18.2.2",
    "globals": "^16.5.0",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "catalog:"
  },
  "size-limit": [
    {
      "path": "packages/openapi-fetch/dist/index.js",
      "limit": "7.5 kB",
      "brotli": false
    }
  ],
  "engines": {
    "node": "^24.15.0 || ^26.0.0"
  }
}
