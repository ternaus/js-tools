{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".vitepress/dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.config.ts"]
    },
    "test-e2e": {
      "env": ["PORT"],
      "dependsOn": ["build"]
    },
    "@example/openapi-fetch-nextjs#test-e2e": {
      "env": ["NEXTJS_PORT", "NEXTJS_API_PORT"],
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["build"]
    }
  },
  "globalDependencies": ["tsconfig.json", "scripts/build.mjs", "pnpm-workspace.yaml"]
}
