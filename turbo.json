{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".vitepress/dist/**"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "lint": {
      "dependsOn": ["build"]
    },
    "size-limit": {
      "dependsOn": ["build"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.config.ts"]
    },
    "test-e2e": {
      "dependsOn": ["build"]
    },
    "typecheck": {
      "dependsOn": ["build"]
    }
  },
  "globalDependencies": ["tsconfig.json", "scripts/build.mjs", "pnpm-workspace.yaml"]
}
